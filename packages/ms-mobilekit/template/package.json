{
  "name": "example-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/Machine-Saver-Inc/example-tool.git" },
  "scripts": {
    "postinstall": "node node_modules/ms-mobilekit/tools/vendor_kit.mjs",
